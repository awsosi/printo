<?xml version="1.0" encoding="utf-8"?>
<!--
  The Printo agent installer.

  Built by `installer/build.ps1`, which publishes the service and the tray self-contained and
  hands this file the resulting directory. Self-contained on purpose: a domain fleet is far
  easier to keep correct when the MSI carries its own runtime than when every workstation needs
  a matching .NET version deployed first, and one missing prerequisite means a bench that
  cannot print.

  Unattended configuration goes into HKLM\SOFTWARE\Printo\Agent rather than into a config file
  written by a custom action. Group Policy writes the identical values to
  HKLM\SOFTWARE\Policies\Printo\Agent and the agent reads both layers, so the ADMX template and
  the MSI properties describe the same settings and no custom action is needed at all - which
  is worth a great deal, because a failed custom action is the most common way an MSI becomes
  neither installable nor removable.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Printo Agent"
           Manufacturer="Printo"
           Version="$(var.ProductVersion)"
           UpgradeCode="7c1f9e10-5c4a-4d0b-9a2f-3f1c0d5b6e21"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="Printo virtual printer agent" Manufacturer="Printo" />

    <!--
      Upgrades replace in place. Scheduled after InstallExecute so the new files are staged
      before the old ones go: a machine that loses power mid-upgrade comes back with one
      working version rather than none.
    -->
    <MajorUpgrade
      Schedule="afterInstallExecute"
      DowngradeErrorMessage="A newer version of the Printo Agent is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!--
      A user interface, because a package a person double-clicks has to be able to tell them
      what happened. Without one, Windows Installer runs the whole install behind a progress
      window that appears and vanishes: a success and a fatal rollback look exactly the same
      from the outside, which is precisely how a 1603 went unexplained on the first machine
      this was ever installed on. GPO deployment and `msiexec /qn` are unaffected - they
      suppress the UI either way.
    -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.NoticeRtf)" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Open Printo Settings, to map this machine's printers" />

    <!--
      The first thing a new machine needs is its printer map, and at that moment the tray has
      not started - the autostart entry does not fire until the next sign-in. Impersonated, so
      the settings window runs as the person who installed rather than as the elevated
      installer, and asynchronous so a window nobody closes cannot hold msiexec open.
    -->
    <CustomAction Id="LaunchSettings"
                  FileRef="TrayExe"
                  ExeCommand="--settings"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchSettings"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <!--
      Resolves the built-in accounts to whatever this machine calls them. Windows localises
      them - on a Polish installation the administrators group is `Administratorzy` and
      `Administrators` resolves to nothing at all - and the ACL below is applied by a deferred
      custom action that looks the name up on the target machine. Naming them in English
      installed cleanly on an English workstation and failed with 1603 on every other one.
    -->
    <util:QueryWindowsWellKnownSIDs />

    <Launch Condition="Installed OR VersionNT64" Message="The Printo Agent requires 64-bit Windows." />

    <!-- Unattended configuration. Every one of these is optional. -->
    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="DECISIONMODE" Secure="yes" />
    <Property Id="CONFIDENCETHRESHOLD" Secure="yes" />
    <Property Id="ENROLLMENTTOKEN" Secure="yes" Hidden="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Printo Agent" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataCompany" Name="Printo">
        <Directory Id="DATAFOLDER" Name="agent" />
      </Directory>
    </StandardDirectory>

    <!-- All-users Start Menu: the install is perMachine and a packing bench is shared. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SHORTCUTFOLDER" Name="Printo" />
    </StandardDirectory>

    <Feature Id="Agent" Title="Printo Agent" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AgentPayload" />
      <ComponentGroupRef Id="AgentRegistration" />
    </Feature>

    <!--
      The one custom action in this package, and it only ever runs on uninstall.

      The queue itself is created by the service, not from here: it can only be created while
      the IPP endpoint is answering, it has to be repaired when somebody deletes it, and a
      failure at install time would be a failure of the install. Removing it is the opposite
      case - at uninstall the service is about to stop for good, and a queue left behind is a
      printer that accepts jobs into a socket nothing is listening on.

      `Return="ignore"` because a package that cannot be uninstalled is a far worse outcome than
      an orphaned printer, and the printer can be removed by hand. Scheduled before the service
      is stopped, so `Printo.Agent.exe` is still on disk, and excluded during a major upgrade so
      an upgrade does not silently remove the operator's default printer and put it back.
    -->
    <CustomAction Id="RemoveVirtualPrinter"
                  FileRef="AgentServiceExe"
                  ExeCommand="--remove-virtual-printer"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoveVirtualPrinter"
              Before="StopServices"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <ComponentGroup Id="AgentRegistration">

      <!--
        The service runs as LocalSystem so it survives sign-out and can watch machine-wide
        directories. ErrorControl is `normal`, not critical: a workstation must still boot if
        the agent fails to start.
      -->
      <Component Id="AgentService" Directory="INSTALLFOLDER" Guid="2b9a0c44-98f4-4b6e-9f1a-77e5f0a1c331">
        <File Id="AgentServiceExe" Source="$(var.ServiceDir)\Printo.Agent.exe" KeyPath="yes" />

        <ServiceInstall Id="PrintoAgentService"
                        Name="PrintoAgent"
                        DisplayName="Printo Agent"
                        Description="Routes printed documents to the right physical printers."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <!-- Restart on failure twice, then stop and let the event log stand. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="none"
                              RestartServiceDelayInSeconds="60" />
        </ServiceInstall>

        <ServiceControl Id="PrintoAgentControl"
                        Name="PrintoAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <!--
        The tray executable, declared rather than harvested so the exit dialog and the
        shortcuts can refer to it by id.
      -->
      <Component Id="TrayApp" Directory="INSTALLFOLDER" Guid="6a1d3f75-2c48-4e91-b3f6-0d5a7c92e184">
        <File Id="TrayExe" Source="$(var.TrayDir)\Printo.Tray.exe" KeyPath="yes" />
      </Component>

      <!--
        The tray is per-user and starts at sign-in. HKLM rather than HKCU because a packing
        bench is shared: the picker has to appear for every operator, not only for whoever
        happened to be signed in when the MSI ran.
      -->
      <Component Id="TrayAutostart" Directory="INSTALLFOLDER" Guid="4d6c2f18-3a77-4e59-8c02-6b9d41a7e552">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="PrintoTray"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]Printo.Tray.exe&quot;"
                       KeyPath="yes" />
      </Component>

      <!--
        Something to open. Without it the whole install is invisible: a headless service and an
        autostart entry that only fires at the next sign-in, which reads to the person who ran
        the MSI as nothing having happened at all. The shortcut launches the same tray the
        autostart entry does, so it is also the recovery path when someone exits the tray.
      -->
      <Component Id="TrayShortcut" Directory="SHORTCUTFOLDER" Guid="5e2a8c37-1b94-4f60-a7d3-0c6e8b2f9a15">
        <Shortcut Id="PrintoTrayShortcut"
                  Name="Printo"
                  Description="Printo agent status, printers and the fallback picker."
                  Target="[INSTALLFOLDER]Printo.Tray.exe"
                  WorkingDirectory="INSTALLFOLDER" />

        <!--
          A direct route to the settings, because the tray is not running yet on the machine
          where someone has just run the MSI: the autostart entry does not fire until the next
          sign-in, and the first thing a new install needs is its printers mapped.
        -->
        <Shortcut Id="PrintoSettingsShortcut"
                  Name="Printo Settings"
                  Description="Map this machine's printers and watched folders."
                  Target="[INSTALLFOLDER]Printo.Tray.exe"
                  Arguments="--settings"
                  WorkingDirectory="INSTALLFOLDER" />

        <RemoveFolder Id="RemoveShortcutFolder" Directory="SHORTCUTFOLDER" On="uninstall" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Printo\Agent" Name="Shortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!--
        Machine data: the spool database, the cached rule bundle and the enrolment credential.
        In ProgramData rather than the install directory because the MSI replaces the install
        directory on upgrade, and a site's queued work and identity must survive that.

        Every account is named through a property rather than in English, because these names
        are localised and the lookup happens on the target machine - see QueryWindowsWellKnownSIDs
        above.

        Users are granted read and write, which is weaker than it first looks and is deliberate:
        the tray runs as the signed-in operator and has to read this machine's configuration, the
        spooled document the picker is asking about, and the queue it reports in its tooltip. An
        ACL of SYSTEM and administrators alone reads well in a security review and leaves an
        operator with a settings window that cannot open and a picker with no thumbnails.

        What actually needs protecting is the enrolment credential, and that is protected where
        it lives: the agent locks `identity.json` down to SYSTEM and the administrators group as
        it writes it, from well-known SIDs, which cannot be mis-localised.
      -->
      <Component Id="DataDirectory" Directory="DATAFOLDER" Guid="8f30b1a6-2d54-4c73-b8e1-9a4f6d2c0b18">
        <CreateFolder>
          <util:PermissionEx User="[WIX_ACCOUNT_LOCALSYSTEM]" GenericAll="yes" Inheritable="yes" />
          <util:PermissionEx User="[WIX_ACCOUNT_ADMINISTRATORS]" GenericAll="yes" Inheritable="yes" />
          <util:PermissionEx User="[WIX_ACCOUNT_USERS]"
                             GenericRead="yes"
                             GenericWrite="yes"
                             GenericExecute="yes"
                             Delete="yes"
                             Inheritable="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM" Key="SOFTWARE\Printo\Agent" Name="DataDirectory"
                       Type="string" Value="[DATAFOLDER]" KeyPath="yes" />
      </Component>

      <!--
        The unattended settings, each written only when its property was supplied. An absent
        property leaves whatever is already there alone: a repair or an upgrade run without
        properties must not silently blank a working machine's server URL.
      -->
      <Component Id="ConfiguredServerUrl" Directory="INSTALLFOLDER" Guid="a3c81d92-6e45-4b17-9d3a-5c2e8f0b7a44"
                 Condition="SERVERURL">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Printo\Agent" Name="ServerUrl"
                       Type="string" Value="[SERVERURL]" KeyPath="yes" />
      </Component>

      <Component Id="ConfiguredDecisionMode" Directory="INSTALLFOLDER" Guid="c5e07b31-9f28-4a66-8b04-1d7a3e5c9f60"
                 Condition="DECISIONMODE">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Printo\Agent" Name="DecisionMode"
                       Type="string" Value="[DECISIONMODE]" KeyPath="yes" />
      </Component>

      <Component Id="ConfiguredThreshold" Directory="INSTALLFOLDER" Guid="e18d4a07-7c63-4f92-a5b8-2e6f0c4d8137"
                 Condition="CONFIDENCETHRESHOLD">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Printo\Agent" Name="ConfidenceThreshold"
                       Type="string" Value="[CONFIDENCETHRESHOLD]" KeyPath="yes" />
      </Component>

      <!--
        The enrolment token is spent the first time the agent starts. Written to the machine key
        rather than the policy key so an administrator can clear it afterwards without editing
        a GPO.
      -->
      <Component Id="ConfiguredEnrollmentToken" Directory="INSTALLFOLDER" Guid="f92b6c50-4d81-4e35-9c77-8a1b3f6e2d09"
                 Condition="ENROLLMENTTOKEN">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Printo\Agent" Name="EnrollmentToken"
                       Type="string" Value="[ENROLLMENTTOKEN]" KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Package>
</Wix>
