<?xml version="1.0" encoding="utf-8"?>
<!--
  Group Policy template for the Printo agent.

  Copy this file to the domain's central store (\\<domain>\SYSVOL\<domain>\Policies\PolicyDefinitions)
  together with en-US\Printo.adml, and the settings appear under
  Computer Configuration > Policies > Administrative Templates > Printo > Agent.

  Everything here writes to SOFTWARE\Policies\Printo\Agent, which is the key the agent reads
  first and marks as managed - the tray then shows the value as read-only, the way Windows does
  for every other policy-controlled setting. An editable box that silently reverts at the next
  policy refresh is worse than no box at all.

  Deliberately absent: the printer map and the watched folders. Those are per-machine facts -
  this bench has that thermal printer - and pushing them by GPO would mean one policy object per
  workstation, which is not a policy, it is a spreadsheet. They live in agent.json, or are
  configured centrally per agent from the fleet console.
-->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   revision="1.1"
                   schemaVersion="1.0"
                   xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">

  <policyNamespaces>
    <target prefix="printo" namespace="Printo.Policies.Agent" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>

  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_PrintoAgent_1" displayName="$(string.SUPPORTED_PrintoAgent_1)" />
      <definition name="SUPPORTED_PrintoAgent_2" displayName="$(string.SUPPORTED_PrintoAgent_2)" />
    </definitions>
  </supportedOn>

  <categories>
    <category name="Printo" displayName="$(string.Printo)" />
    <category name="Agent" displayName="$(string.Agent)">
      <parentCategory ref="Printo" />
    </category>
  </categories>

  <policies>

    <policy name="ServerUrl"
            class="Machine"
            displayName="$(string.ServerUrl)"
            explainText="$(string.ServerUrl_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.ServerUrl)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_1" />
      <elements>
        <text id="ServerUrl_Text" valueName="ServerUrl" required="true" expandable="false" maxLength="512" />
      </elements>
    </policy>

    <policy name="DecisionMode"
            class="Machine"
            displayName="$(string.DecisionMode)"
            explainText="$(string.DecisionMode_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.DecisionMode)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_1" />
      <elements>
        <enum id="DecisionMode_Enum" valueName="DecisionMode" required="true">
          <item displayName="$(string.DecisionMode_Local)">
            <value><string>local</string></value>
          </item>
          <item displayName="$(string.DecisionMode_Server)">
            <value><string>server</string></value>
          </item>
          <item displayName="$(string.DecisionMode_Auto)">
            <value><string>auto</string></value>
          </item>
        </enum>
      </elements>
    </policy>

    <policy name="ConfidenceThreshold"
            class="Machine"
            displayName="$(string.ConfidenceThreshold)"
            explainText="$(string.ConfidenceThreshold_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.ConfidenceThreshold)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_1" />
      <elements>
        <!--
          Text rather than a decimal element: ADMX decimals are integers only, and the agent's
          threshold is 0..1. It parses and range-checks the string, and ignores anything outside
          the range rather than coercing it - a threshold of 12 would escalate every page.
        -->
        <text id="ConfidenceThreshold_Text" valueName="ConfidenceThreshold" required="true" maxLength="8" />
      </elements>
    </policy>

    <policy name="EnrollmentToken"
            class="Machine"
            displayName="$(string.EnrollmentToken)"
            explainText="$(string.EnrollmentToken_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.EnrollmentToken)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_1" />
      <elements>
        <text id="EnrollmentToken_Text" valueName="EnrollmentToken" required="true" maxLength="256" />
      </elements>
    </policy>

    <policy name="OcrLanguage"
            class="Machine"
            displayName="$(string.OcrLanguage)"
            explainText="$(string.OcrLanguage_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.OcrLanguage)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_1" />
      <elements>
        <text id="OcrLanguage_Text" valueName="OcrLanguage" required="false" maxLength="32" />
      </elements>
    </policy>

    <policy name="VirtualPrinterEnabled"
            class="Machine"
            displayName="$(string.VirtualPrinterEnabled)"
            explainText="$(string.VirtualPrinterEnabled_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            valueName="VirtualPrinterEnabled">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_1" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy name="VirtualPrinterName"
            class="Machine"
            displayName="$(string.VirtualPrinterName)"
            explainText="$(string.VirtualPrinterName_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.VirtualPrinterName)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_1" />
      <elements>
        <text id="VirtualPrinterName_Text" valueName="VirtualPrinterName" required="true" maxLength="64" />
      </elements>
    </policy>

    <policy name="VirtualPrinterPort"
            class="Machine"
            displayName="$(string.VirtualPrinterPort)"
            explainText="$(string.VirtualPrinterPort_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.VirtualPrinterPort)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_1" />
      <elements>
        <decimal id="VirtualPrinterPort_Decimal" valueName="VirtualPrinterPort"
                 minValue="1024" maxValue="65535" required="true" />
      </elements>
    </policy>

    <policy name="VirtualPrinterManageQueue"
            class="Machine"
            displayName="$(string.VirtualPrinterManageQueue)"
            explainText="$(string.VirtualPrinterManageQueue_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            valueName="VirtualPrinterManageQueue">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_1" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- 0.1.15: where waybill copies print, thermal stock, log files, spool clean-up, service control. -->

    <policy name="WaybillHandling"
            class="Machine"
            displayName="$(string.WaybillHandling)"
            explainText="$(string.WaybillHandling_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.WaybillHandling)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_2" />
      <elements>
        <enum id="WaybillHandling_Enum" valueName="WaybillHandling" required="true">
          <item displayName="$(string.WaybillHandling_Route)"><value><string>route</string></value></item>
          <item displayName="$(string.WaybillHandling_A4)"><value><string>a4</string></value></item>
          <item displayName="$(string.WaybillHandling_Thermal)"><value><string>thermal</string></value></item>
          <item displayName="$(string.WaybillHandling_Skip)"><value><string>skip</string></value></item>
        </enum>
      </elements>
    </policy>

    <policy name="ThermalMedia"
            class="Machine"
            displayName="$(string.ThermalMedia)"
            explainText="$(string.ThermalMedia_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.ThermalMedia)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_2" />
      <elements>
        <text id="ThermalMedia_Text" valueName="ThermalMedia" required="true" maxLength="32" />
      </elements>
    </policy>

    <policy name="LogToFile"
            class="Machine"
            displayName="$(string.LogToFile)"
            explainText="$(string.LogToFile_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            valueName="LogToFile">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_2" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy name="LogLevel"
            class="Machine"
            displayName="$(string.LogLevel)"
            explainText="$(string.LogLevel_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.LogLevel)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_2" />
      <elements>
        <enum id="LogLevel_Enum" valueName="LogLevel" required="true">
          <item displayName="$(string.LogLevel_Debug)"><value><string>Debug</string></value></item>
          <item displayName="$(string.LogLevel_Information)"><value><string>Information</string></value></item>
          <item displayName="$(string.LogLevel_Warning)"><value><string>Warning</string></value></item>
          <item displayName="$(string.LogLevel_Error)"><value><string>Error</string></value></item>
          <item displayName="$(string.LogLevel_Critical)"><value><string>Critical</string></value></item>
        </enum>
      </elements>
    </policy>

    <policy name="LogMaxFileSizeMb"
            class="Machine"
            displayName="$(string.LogMaxFileSizeMb)"
            explainText="$(string.LogMaxFileSizeMb_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.LogMaxFileSizeMb)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_2" />
      <elements>
        <decimal id="LogMaxFileSizeMb_Decimal" valueName="LogMaxFileSizeMb" minValue="1" maxValue="1024" required="true" />
      </elements>
    </policy>

    <policy name="LogMaxFiles"
            class="Machine"
            displayName="$(string.LogMaxFiles)"
            explainText="$(string.LogMaxFiles_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.LogMaxFiles)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_2" />
      <elements>
        <decimal id="LogMaxFiles_Decimal" valueName="LogMaxFiles" minValue="1" maxValue="100" required="true" />
      </elements>
    </policy>

    <policy name="KeepPrintedHours"
            class="Machine"
            displayName="$(string.KeepPrintedHours)"
            explainText="$(string.KeepPrintedHours_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.KeepPrintedHours)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_2" />
      <elements>
        <decimal id="KeepPrintedHours_Decimal" valueName="KeepPrintedHours" minValue="0" maxValue="8760" required="true" />
      </elements>
    </policy>

    <policy name="KeepHistoryDays"
            class="Machine"
            displayName="$(string.KeepHistoryDays)"
            explainText="$(string.KeepHistoryDays_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.KeepHistoryDays)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_2" />
      <elements>
        <decimal id="KeepHistoryDays_Decimal" valueName="KeepHistoryDays" minValue="1" maxValue="3650" required="true" />
      </elements>
    </policy>

    <policy name="ExpireUnprintedDays"
            class="Machine"
            displayName="$(string.ExpireUnprintedDays)"
            explainText="$(string.ExpireUnprintedDays_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.ExpireUnprintedDays)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_2" />
      <elements>
        <decimal id="ExpireUnprintedDays_Decimal" valueName="ExpireUnprintedDays" minValue="1" maxValue="3650" required="true" />
      </elements>
    </policy>

    <policy name="MaxSpoolMb"
            class="Machine"
            displayName="$(string.MaxSpoolMb)"
            explainText="$(string.MaxSpoolMb_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            presentation="$(presentation.MaxSpoolMb)">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_2" />
      <elements>
        <decimal id="MaxSpoolMb_Decimal" valueName="MaxSpoolMb" minValue="50" maxValue="1048576" required="true" />
      </elements>
    </policy>

    <policy name="UsersCanControlService"
            class="Machine"
            displayName="$(string.UsersCanControlService)"
            explainText="$(string.UsersCanControlService_Explain)"
            key="SOFTWARE\Policies\Printo\Agent"
            valueName="UsersCanControlService">
      <parentCategory ref="Agent" />
      <supportedOn ref="SUPPORTED_PrintoAgent_2" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

  </policies>
</policyDefinitions>
