<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A Windows TFM so the suite can reference Printo.Agent.Ocr, which needs the WinRT
      projection for the inbox recogniser. The routing engine itself stays on a portable TFM;
      its cross-platform behaviour is covered by the TypeScript side running the same
      conformance fixtures.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Printo.Agent.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Printo.Agent.Core\Printo.Agent.Core.csproj" />
    <ProjectReference Include="..\Printo.Agent.Render\Printo.Agent.Render.csproj" />
    <ProjectReference Include="..\Printo.Agent.Printing\Printo.Agent.Printing.csproj" />
    <ProjectReference Include="..\Printo.Agent.Ocr\Printo.Agent.Ocr.csproj" />
    <ProjectReference Include="..\Printo.Agent.Runtime\Printo.Agent.Runtime.csproj" />
    <ProjectReference Include="..\Printo.Agent.Tray\Printo.Agent.Tray.csproj" />
  </ItemGroup>

</Project>
