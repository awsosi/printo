<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!--
      The same Windows TFM as the service, and that is not a detail.

      The two executables are published into one directory - they share almost every assembly
      and two copies of the runtime would double the MSI - so whichever publishes last wins any
      file they both contribute. With different Windows TFMs they contribute *different
      versions* of the WinRT projection, `Microsoft.Windows.SDK.NET.dll`: the tray's 17763 copy
      overwrote the service's 19041 copy, and the service then failed to load the assembly its
      own deps.json named. Every install produced a service that started and died on the spot,
      with a FileNotFoundException in the event log and 1603 in front of whoever ran the MSI.

      `SupportedOSPlatformVersion` still says 17763, which is the thing that actually matters
      for a Windows 10 1809 machine: the TFM decides which APIs compile, this decides which the
      analyser will let us call unguarded.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Printo.Agent.Tray</RootNamespace>
    <AssemblyName>Printo.Tray</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Required by the LibraryImport source generator, which emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      The picker must appear on the active monitor at the right size on a mixed-DPI desk, which
      is the common setup: a laptop panel plus an external screen.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <ApplicationIcon>$(PrintoIcon)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The same file again, as a resource this time.

      ApplicationIcon puts the mark on the executable, which is what the shell reads. It is not
      reachable as an icon at a chosen size, and the notification area needs exactly that: the
      small-icon size for the current DPI, so that a 125% display gets the 20-pixel drawing
      rather than the 16-pixel one stretched. Hence one file embedded twice - see BrandIcon.
    -->
    <EmbeddedResource Include="$(PrintoIcon)" LogicalName="Printo.Tray.Brand.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Printo.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Printo.Agent.Core\Printo.Agent.Core.csproj" />
    <ProjectReference Include="..\Printo.Agent.Render\Printo.Agent.Render.csproj" />
    <ProjectReference Include="..\Printo.Agent.Printing\Printo.Agent.Printing.csproj" />
    <ProjectReference Include="..\Printo.Agent.Runtime\Printo.Agent.Runtime.csproj" />
  </ItemGroup>

</Project>
