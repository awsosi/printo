<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Printo.Agent.Runtime</RootNamespace>
    <AssemblyName>Printo.Agent.Runtime</AssemblyName>

    <!-- Required by the LibraryImport source generator, which emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Printo.Agent.Core\Printo.Agent.Core.csproj" />
    <ProjectReference Include="..\Printo.Agent.Render\Printo.Agent.Render.csproj" />
    <ProjectReference Include="..\Printo.Agent.Printing\Printo.Agent.Printing.csproj" />
  </ItemGroup>

  <!--
    SQLite rather than a file-per-job queue: the spool has to survive a hard kill without
    losing or duplicating a job, and "claim a row in a transaction" is a solved problem that a
    directory of marker files is not.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!--
    The wire serializer options and the report builder are internal on purpose - they are
    implementation, not API - but both are worth asserting directly rather than only through
    an HTTP round trip.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Printo.Agent.Tests" />
  </ItemGroup>

</Project>
