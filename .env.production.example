# Printo, production environment.
#
#   cp .env.production.example .env
#   $EDITOR .env
#   docker compose -f infra/docker-compose.prod.yml up -d --build
#
# Every REPLACE- value below must be changed. The compose file declares these with
# `${VAR:?set VAR}`, so the stack refuses to start rather than coming up with a known-weak
# default - a printing service that quietly issues forgeable tokens is worse than one that
# will not start.
#
# Generate the three secrets with:
#   openssl rand -hex 32
#
# Hex rather than base64 on purpose. POSTGRES_PASSWORD is interpolated into a
# `postgres://user:password@db:5432/name` URL, so a password containing / @ : + # or ? has to be
# percent-encoded or the API cannot parse its own connection string. Hex avoids the question
# entirely at the same 256 bits of entropy. (The API refuses to start with a clear message
# rather than a bare "Invalid URL" if this is got wrong.)

NODE_ENV=production

# --- Database -------------------------------------------------------------------------------
POSTGRES_DB=printo
POSTGRES_USER=printo
POSTGRES_PASSWORD=REPLACE-with-a-generated-password

# --- Token signing --------------------------------------------------------------------------
# Changing either invalidates every issued token, which is the intended way to log everyone out.
JWT_ACCESS_SECRET=REPLACE-with-a-generated-secret
JWT_REFRESH_SECRET=REPLACE-with-a-different-generated-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AUTH_HASH_STRATEGY=auto

# --- External authentication ------------------------------------------------------------------
# Leave both empty to use local accounts only.
EXTAUTH_BASE_URL=
EXTAUTH_API_KEY=

# One-shot token that permits creating the first ADMIN account. Clear it once that is done.
BOOTSTRAP_ADMIN_TOKEN=

# --- Edge ---------------------------------------------------------------------------------------
# Only Traefik publishes ports. Change these if 80/443 are already taken on the host.
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# --- Worker -------------------------------------------------------------------------------------
WORKER_SCANNER=auto
# `socket` sends to real printers. `mock` records instead, which is what the smoke test uses.
WORKER_DISPATCH_PROVIDER_MODE=socket
WORKER_DISPATCH_TIMEOUT_MS=5000
WORKER_POLL_INTERVAL_MS=60000
# JSON map keyed by printer id, e.g. {"printer-id":{"provider":"socket","targetUri":"socket://10.0.0.10:9100"}}
WORKER_PRINTER_PROVIDER_OVERRIDES=
WORKER_CLASSIFIER=auto

# `full` builds the vision service with the rasterizer, barcode decoder and OCR. `minimal`
# builds heuristics only and is much faster to build, but cannot see a label it has to look at.
VISION_BUILD_PROFILE=full

# --- Housekeeping -------------------------------------------------------------------------------
# How often retention runs, in hours. 0 hands the job to an external cron instead.
RETENTION_INTERVAL_HOURS=24
