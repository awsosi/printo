NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WORKER_PORT=5000
DB_PORT=5432
REDIS_PORT=6379
WORKER_POLL_INTERVAL_MS=60000
WORKER_SCANNER=auto
WORKER_DISPATCH_PROVIDER_MODE=mock
WORKER_DISPATCH_TIMEOUT_MS=5000
# JSON map keyed by printer id/name, e.g. {"printer-id":{"provider":"socket","targetUri":"socket://10.0.0.10:9100","timeoutMs":4000}}
WORKER_PRINTER_PROVIDER_OVERRIDES=
# SMB secret refs can use env:KEY or WORKER_SECRET_<NORMALIZED_SECRET_REF>
WORKER_SECRET_SECRET__SMOKE=

DATABASE_URL=postgres://printo:printo@db:5432/printo
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

AUTH_HASH_STRATEGY=auto
EXTAUTH_BASE_URL=http://ff.vitkac.local
EXTAUTH_API_KEY=replace-me
BOOTSTRAP_ADMIN_TOKEN=
