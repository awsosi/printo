  {
   "name": "A profile's own handling applies when the host sets none",
   "profile": {
    "profile": "Inline waybill skip",
    "match": {
     "filenameMask": "*"
    },
    "confidenceThreshold": 0.75,
    "pageRules": [
     {
      "id": "everything-thermal",
      "name": "Everything to thermal",
      "when": {
       "geometry": {
        "inkShortEdgeMm": {
         "min": 1
        }
       }
      },
      "then": {
       "route": "THERMAL",
       "confidence": 1
      }
     }
    ],
    "waybills": {
     "handling": "skip",
     "rules": [
      {
       "id": "waybill-marker",
       "name": "Marked waybill",
       "when": {
        "text": {
         "contains": "WAYBILL"
        }
       },
       "then": {
        "confidence": 1
       }
      }
     ]
    },
    "fallback": {
     "route": "A4",
     "onUnknown": "route"
    }
   },
   "document": {
    "fileName": "OneClickPrint_TEST.pdf",
    "pageCount": 1,
